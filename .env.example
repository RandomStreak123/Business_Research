# ==============================================================================
# Enterprise Agent Research Backend - Environment Configuration Template
# Copy this file to .env and insert your API keys:
#   cp .env.example .env
# ==============================================================================

# Required: Groq API Key for fast LLM inference (Free tier at https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Required: Tavily API Key for concurrent web search (Free tier at https://tavily.com)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: Override primary model (default: openai/gpt-oss-120b)
# PRIMARY_MODEL=openai/gpt-oss-120b

# Optional: Strict anti-hallucination temperature (default: 0.1)
# LLM_TEMPERATURE=0.1
